# ── 에셋 패키지 (1GB) ─────────────────────────────
# download.codyssey.kr/Youngpoong.zip 압축 해제 결과. git에 올리지 않는다.
Youngpoong/
*.unitypackage
*.mp4

# ── 데이터 ────────────────────────────────────────
# 정제 결과는 커밋하지 않는다 (컨테이너가 모듈 1 을 돌려 만든다).
# 단 data/fixtures/ 는 병렬 개발용 계약 샘플이므로 커밋한다.
#
# 원본 .xlsx(59KB)는 커밋한다 — 2026-11-09 변경.
#   근거 1. 명세 #2 레포지토리 구조: "data/: 원본 데이터 및 전처리된 데이터
#           (개인정보/보안 데이터 제외)" → 넣는 것이 명세 요구사항이다.
#   근거 2. 제외 조건인 개인정보가 없다. 16개 컬럼 전부 배치·성분·공정·회수율이고,
#           파일 메타데이터의 작성자/최종수정자 실명은 제거했다.
#   근거 3. 이게 없으면 클론 후 `docker compose up` 이 성립하지 않는다.
#           종전 절차는 1GB 에셋 zip 을 받아 59KB 엑셀만 꺼내는 것이었다.
#   되돌리려면 아래 `!data/raw/*.xlsx` 한 줄만 지우면 된다.
data/raw/*
!data/raw/.gitkeep
!data/raw/*.xlsx
data/processed/*
!data/processed/.gitkeep

# ── 산출물 ────────────────────────────────────────
artifacts/*
!artifacts/.gitkeep
# 보고서 그림은 커밋한다 — 2026-11-09 변경.
#   명세 #2-4 가 보고서에 "EDA 내용 및 시각화 결과" 를 요구하는데, 종전처럼
#   전부 제외하면 GitHub 에서 REPORT.md 의 이미지가 하나도 보이지 않는다.
#   현재 10장 828KB 수준이라 저장소 부담이 없다.
#   큰 중간 산출물(.npy, .csv 등)은 계속 제외된다.
docs/figures/*
!docs/figures/.gitkeep
!docs/figures/*.png
!docs/figures/*.md

# 3D 씬의 단일 파일 묶음 — build_standalone.py 가 만든다.
# docs/modeling/data.json 은 반대로 커밋한다 (클론만으로는 만들 재료가 없다).
docs/modeling/standalone.html

# ── Python ───────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Unity ────────────────────────────────────────
unity/**/[Ll]ibrary/
unity/**/[Tt]emp/
unity/**/[Oo]bj/
unity/**/[Bb]uild/
unity/**/[Bb]uilds/
unity/**/[Ll]ogs/
unity/**/[Uu]ser[Ss]ettings/
unity/**/[Mm]emoryCaptures/
unity/**/[Rr]ecordings/
unity/**/*.csproj
unity/**/*.sln
unity/**/*.unityproj
unity/**/*.apk
unity/**/*.app
unity/**/*.exe
unity/**/sysinfo.txt
unity/**/crashlytics-build.properties

# ── OS / IDE ─────────────────────────────────────
.DS_Store
.idea/
.vscode/
# 엑셀·워드가 파일을 열어 둔 동안 만드는 잠금 파일
~$*

# 강의 과제 자료 (저장소 산출물 아님)
homework/

# 논문 작업물
example/
*.docx
*.pdf
